{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{4,6}$/)",
        "meta": {
          ".write": "$code.matches(/^[A-Z0-9]{4,6}$/)",
          ".validate": "newData.hasChildren(['host', 'status', 'max', 'round'])",
          "host": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'" },
          "max": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 6" },
          "round": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
          "clock": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60" },
          "created": { ".validate": "newData.isNumber()" },
          "picks": { "$id": { ".validate": "$id.matches(/^p[a-z0-9]{1,15}$/) && newData.isBoolean()" } },
          "kicked": { "$id": { ".validate": "$id.matches(/^p[a-z0-9]{1,15}$/) && newData.isBoolean()" } },
          "$other": { ".validate": false }
        },
        "members": {
          "$id": {
            ".write": "$id.matches(/^p[a-z0-9]{1,15}$/)",
            ".validate": "newData.hasChildren(['name', 'online'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "logo": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100" },
            "style": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100" },
            "joined": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "cursors": {
          "$id": {
            ".write": "$id.matches(/^p[a-z0-9]{1,15}$/)",
            ".validate": "newData.hasChildren(['x', 'y'])",
            "x": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 200" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 200" },
            "r": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "emotes": {
          "$key": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['by', 'e'])",
            "by": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "e": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "$other": { ".validate": false }
          }
        },
        "rounds": {
          "$n": {
            ".write": "!data.exists() && $n.matches(/^[0-9]{1,5}$/)",
            ".validate": "newData.hasChildren(['seed', 'order'])",
            "seed": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "order": { "$i": { ".validate": "newData.isString() && newData.val().length <= 16" } },
            "$other": { ".validate": false }
          }
        },
        "moves": {
          "$n": {
            "$key": {
              ".write": "!data.exists() && $n.matches(/^[0-9]{1,5}$/)",
              ".validate": "newData.hasChildren(['by', 'layer'])",
              "by": { ".validate": "newData.isString() && newData.val().length <= 16" },
              "layer": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
              "tile": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100" },
              "kind": { ".validate": "newData.val() === 'drop'" },
              "$other": { ".validate": false }
            }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
