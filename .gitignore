# Fingerprints from tools/checks/check.js, tools/checks/playtest.js and tools/checks/econsim.js: big, and easy to make again.
tools/checks/out/

# The ascii-art.de catalog: a big reference copy, kept local only (the user, 2026-10-23).
ascii-editor/reference/ascii-art-de/

# macOS folder settings and resource forks: OS clutter, not project files.
.DS_Store
._*
# Windows thumbnail caches and folder settings: OS clutter.
Thumbs.db
desktop.ini

# Editor settings: personal, not part of the project.
.vscode/
.idea/
# Vim swap files and backup copies: temporary.
*.swp
*~

# Installed Node packages: reinstalled from package files, never committed.
node_modules/
# Logs from tools and servers: temporary output.
*.log
# Local secrets.
.env
# Claude Code settings for this machine only.
.claude/settings.local.json

# Agent worktrees (Claude Code): separate checkouts, not part of the repo.
.claude/worktrees/

# Files moved aside instead of deleted (the user can empty it).
_trash/

# The neon editor's copy for the site (tools/deploy_editor.js, run by bump.js): made again any time; it's uploaded
# with dist/, not committed.
dist/tools/
